---
import ToolSearch from '@/components/layout/ToolSearch.astro';
import ToolGrid from '@/components/tool/ToolGrid.astro';
import { bodyClass, buttonVariants, cn, containerClass, h1Class, h2Class } from '@/components/ui/styles';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPopularTools } from '@/lib/tools';
---

<BaseLayout
  title="Page Not Found"
  description="The page you were looking for could not be found. Search ToolKade's free online tools or browse popular calculators and converters instead."
  noindex
>
  <div class={cn(containerClass, 'py-12 md:py-20')}>
    <div class="max-w-2xl">
      <p class="text-sm font-semibold tracking-wide text-brand-700 uppercase dark:text-brand-300">
        Error 404
      </p>
      <h1 class={cn(h1Class, 'mt-2')}>We could not find that page</h1>
      <p class={cn(bodyClass, 'mt-3 text-lg')}>
        The link may be old or mistyped. Search for the tool you need, or go back to the home page.
      </p>
      <ToolSearch id="notfound-tool-search" class="mt-6" />
      <a href="/" class={cn(buttonVariants.secondary, 'mt-6')}>
        Go to the home page
      </a>
    </div>

    <section aria-labelledby="popular" class="mt-16">
      <h2 id="popular" class={h2Class}>
        Popular tools
      </h2>
      <ToolGrid tools={getPopularTools(4)} class="mt-6" />
    </section>
  </div>
</BaseLayout>
