---
import ToolLayout from '@/layouts/ToolLayout.astro';
import { getTool } from '@/lib/tools';
import Tool from '@/tools/image-compressor/Tool';
import { content } from '@/tools/image-compressor/content';

const tool = getTool('image-compressor')!;
---

<ToolLayout tool={tool} content={content}>
  <Tool client:visible />
</ToolLayout>
