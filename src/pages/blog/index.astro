---
import BlogIndex from '@/components/blog/BlogIndex.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPosts, POSTS_PER_PAGE } from '@/lib/blog';

const posts = await getPublishedPosts();
const lastPage = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
---

<BaseLayout
  title="Blog: Guides to Sri Lankan Tax, Bills & Tools"
  description="Plain-English guides to APIT tax, vehicle import duty and CEB electricity bills in Sri Lanka, plus how-tos for image, PDF and developer tasks."
  noindex={posts.length === 0}
>
  <BlogIndex posts={posts.slice(0, POSTS_PER_PAGE)} currentPage={1} lastPage={lastPage} />
</BaseLayout>
