---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 1 && (
  <nav
    aria-labelledby="toc-heading"
    class="rounded-card border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900"
  >
    <h2 id="toc-heading" class="text-sm font-semibold tracking-wide text-slate-900 uppercase dark:text-white">
      On this page
    </h2>
    <ol class="mt-3 space-y-1.5 text-sm">
      {items.map((heading) => (
        <li class:list={[heading.depth === 3 && 'ml-4']}>
          <a
            href={`#${heading.slug}`}
            class="text-slate-600 hover:text-brand-700 hover:underline dark:text-slate-400 dark:hover:text-brand-300"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
