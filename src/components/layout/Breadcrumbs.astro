---
import JsonLd from '@/components/seo/JsonLd.astro';
import { breadcrumbSchema, type BreadcrumbItem } from '@/components/seo/schema';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  /** Trail after "Home". The last item is the current page. */
  items: BreadcrumbItem[];
  class?: string;
}

const trail: BreadcrumbItem[] = [{ name: 'Home', href: '/' }, ...Astro.props.items];
---

<nav aria-label="Breadcrumb" class={Astro.props.class}>
  <ol class="flex flex-wrap items-center gap-1 text-sm text-slate-500 dark:text-slate-400">
    {trail.map((item, index) => {
      const isLast = index === trail.length - 1;
      return (
        <li class="flex items-center gap-1">
          {index > 0 && <Icon name="ChevronRight" class="size-4 shrink-0" />}
          {isLast ? (
            <span aria-current="page" class="text-slate-700 dark:text-slate-300">
              {item.name}
            </span>
          ) : (
            <a href={item.href} class="hover:text-brand-700 hover:underline dark:hover:text-brand-300">
              {item.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
<JsonLd data={breadcrumbSchema(trail)} />
