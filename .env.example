# Copy to .env for local development. In Cloudflare Pages, set these under Settings → Environment variables.

# Ads render nothing unless this is exactly "true".
PUBLIC_ADS_ENABLED=false
# AdSense publisher ID, e.g. ca-pub-1234567890123456
PUBLIC_ADSENSE_CLIENT=

# Third-party form endpoint for the contact page (e.g. https://formspree.io/f/xxxxxxx).
# When empty, the contact page shows the email address instead of the form.
PUBLIC_FORM_ENDPOINT=
